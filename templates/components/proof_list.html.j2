{# C11 — proof requirements, each independently addressable. #}
{# C3 (round 13) — a page can also carry an authored narrative section with this same
   title ("Required evidence"). When it does, the caller passes `landmark_label` so the
   two regions on that page get distinct accessible names; the visible heading text is
   unchanged either way. #}
{% macro proof_list(items, title, empty_message='None.', heading_level=3, slug='', landmark_label=none) -%}
{% set anchor = (slug or title) | lower | replace(' ', '-') %}
<section{% if landmark_label %} aria-label="{{ landmark_label }}"{% else %} aria-labelledby="proof-{{ anchor }}"{% endif %}>
  <h{{ heading_level }} id="proof-{{ anchor }}">{{ title }}</h{{ heading_level }}>
  {% if items %}
  <ul class="checklist">
    {% for item in items %}
    <li id="proof-{{ item.id }}">
      <div class="card-header">
        <strong>{{ item.description }}</strong>
        <span class="state state-{{ item.state_class }}">{{ item.status_label }}</span>
      </div>
      <p class="authority">
        {{ item.type | replace('-', ' ') | capitalize }}{% if item.path %} · <code>{{ item.path }}</code>{% endif %}{% if item.validator %} · validated by {{ item.validator }}{% endif %}
      </p>
      {% if item.detail %}<p>{{ item.detail }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="authority">{{ empty_message }}</p>
  {% endif %}
</section>
{%- endmacro %}
