{# U04 — find a quest by capability, tool, risk, difficulty or time.

   Without JavaScript this page lists every quest and the filter form is inert: a static
   page cannot filter itself, and the earlier version of this comment claimed otherwise
   (Stage 3 audit S3-H2). The routes that work with no scripting are real pages — a region
   page and a tag page — and they are linked from every card and every quest.

   With JavaScript the form filters live, reflects itself in the query string, and reads
   that query string back on load so a filtered URL can be shared. #}
{% extends "layouts/base.html.j2" %}
{% from "components/quest_card.html.j2" import quest_card %}
{% from "components/empty_state.html.j2" import empty_state %}
{% from "components/filters.html.j2" import filter_form %}

{% block main %}
<header class="page-heading">
  <h1>{{ page.heading }}</h1>
  <p>{{ page.description }}</p>
</header>

{{ filter_form('/catalog/', url, regions, states, levels, tags, bookends, risks, times, selected) }}

<h2 class="visually-hidden">Matching quests</h2>
<p role="status"><strong data-result-count>{{ quests | length }}</strong> quest(s) match.</p>

<div class="card-grid" data-catalog-results>
  {% for quest in quests %}{{ quest_card(quest, url) }}{% endfor %}
</div>

<div data-empty-results{% if quests %} hidden{% endif %}>
  {{ empty_state('No quests match these filters',
      'Nothing in the catalog matches every filter you have set. Reset them to see everything again.',
      'Show all quests', '/catalog/', url) }}
</div>
{% endblock %}
