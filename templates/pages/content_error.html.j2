{# U11 — "Why did the build reject my content, and how do I fix it?"

   Every problem, not only the first, with file, field, expected rule, what was found and a
   suggested correction. The same information is printed to the terminal. #}
{% extends "layouts/base.html.j2" %}

{% block main %}
<header class="page-heading">
  <h1>{{ page.heading }}</h1>
  <p>{{ error_count }} error(s) and {{ warning_count }} warning(s). The previously generated site has been left untouched.</p>
</header>

<div class="alert alert-error" role="alert">
  <p><strong>Nothing was published.</strong></p>
  <p>Content that does not validate is never rendered, so a broken quest cannot reach a participant.</p>
</div>

<h2 class="visually-hidden">Problems found</h2>

<div class="stack">
  {% for problem in problems %}
  <article class="panel">
    <div class="card-header">
      <h3>{{ problem.get('message') }}</h3>
      <span class="state state-{{ 'needs_changes' if problem.get('severity') in ('error', 'blocking') else 'available' }}">{{ problem.get('severity') }}</span>
    </div>
    <dl class="definition-list">
      {% if problem.get('source') %}<dt>File</dt><dd><code>{{ problem.get('source') }}{% if problem.get('line') %}:{{ problem.get('line') }}{% if problem.get('column') %}:{{ problem.get('column') }}{% endif %}{% endif %}</code></dd>{% endif %}
      {% if problem.get('entity_id') %}<dt>Entity</dt><dd><code>{{ problem.get('entity_id') }}</code></dd>{% endif %}
      {% if problem.get('field_path') %}<dt>Field</dt><dd><code>{{ problem.get('field_path') }}</code></dd>{% endif %}
      {% if problem.get('expected') %}<dt>Expected</dt><dd>{{ problem.get('expected') }}</dd>{% endif %}
      {% if problem.get('received') %}<dt>Found</dt><dd><code>{{ problem.get('received') }}</code></dd>{% endif %}
      {% if problem.get('suggestion') %}<dt>Try</dt><dd>{{ problem.get('suggestion') }}</dd>{% endif %}
      <dt>Code</dt><dd><code>{{ problem.get('code') }}</code></dd>
    </dl>
    {% if problem.get('documentation') %}
    <p><a href="{{ url(problem.get('documentation')) }}">Read the authoring guide</a></p>
    {% endif %}
  </article>
  {% endfor %}
</div>
{% endblock %}
