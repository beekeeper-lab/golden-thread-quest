# Copy to .env and fill in locally. .env is gitignored; never commit real values.
# The application reads credentials only from the environment or an authenticated CLI.
# It never stores them, and never writes them to evidence, logs or generated output.

# Where participant-owned files live. Defaults to <repo>/participant (ADR-018).
# GTQ_PARTICIPANT_ROOT=

# Loopback service bind address and port. The address is loopback-only by design;
# changing it is refused at startup (docs/SECURITY-AND-PRIVACY.md).
GTQ_SERVICE_HOST=127.0.0.1
GTQ_SERVICE_PORT=8765

# Optional external systems. Only quests that explicitly declare an external write use these,
# and every write is previewed and confirmed before it happens.
# JIRA_BASE_URL=https://example.atlassian.net
# TRELLO_BASE_URL=https://api.trello.com
