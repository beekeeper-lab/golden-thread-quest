{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-thread.local/schemas/site.schema.json",
  "title": "Golden Thread site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "curriculum", "tagline", "default_track", "navigation"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "curriculum": { "type": "string", "minLength": 3, "maxLength": 100 },
    "professional_role": { "type": "string", "minLength": 3, "maxLength": 100 },
    "tagline": { "type": "string", "minLength": 10, "maxLength": 160 },
    "default_track": { "$ref": "#/$defs/id" },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "route"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 2, "maxLength": 40 },
          "route": { "type": "string", "pattern": "^/[a-z0-9/_-]*$" },
          "icon": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    }
  }
}
