{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-thread.local/schemas/submission.schema.json",
  "title": "Golden Thread submission record",
  "description": "A participant's request for review. It states what is being submitted and what was true about it at the moment of submission, so a reviewer can tell whether the evidence has changed since.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "quest_id",
    "quest_version",
    "attempt_id",
    "content_hash",
    "evidence_hash",
    "submitted_at",
    "submitted_by",
    "secret_scan_clean"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "submission_id": { "$ref": "#/$defs/id" },
    "quest_id": { "$ref": "#/$defs/id" },
    "quest_version": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "#/$defs/id" },
    "content_hash": { "$ref": "#/$defs/hash" },
    "evidence_hash": { "$ref": "#/$defs/hash" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "submitted_by": { "type": "string", "minLength": 1, "maxLength": 100 },
    "secret_scan_clean": { "type": "boolean" },
    "validation_result_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "note": { "type": "string", "maxLength": 2000 },
    "reproduction": { "type": "string", "maxLength": 4000 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
